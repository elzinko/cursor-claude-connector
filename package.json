{
  "name": "claude-proxy",
  "version": "1.1.0",
  "description": "OpenAI-compatible proxy to use your Claude Pro/Max subscription as the model backend in Cursor IDE — no extra API bill",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "start:local": "./start.sh local",
    "start:vercel": "./start.sh vercel",
    "start:dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_TESTS=1 vitest run",
    "coverage": "vitest run --coverage",
    "provision:vercel": "bash scripts/provision-vercel-env.sh",
    "clean": "rm -rf dist",
    "stop": "lsof -ti:9095 | xargs kill 2>/dev/null || echo 'No process on port 9095'",
    "vercel-build": "npm run build"
  },
  "keywords": [
    "cursor",
    "claude",
    "anthropic",
    "openai",
    "proxy",
    "api",
    "connector",
    "code-editor",
    "claude-pro",
    "claude-max",
    "oauth"
  ],
  "author": "elzinko",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@simplewebauthn/server": "^13.3.3",
    "@upstash/redis": "^1.38.3",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
